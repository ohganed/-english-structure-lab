{
  "schemaVersion": "0.1",
  "appId": "english-structure-lab",
  "name": "英文構造ラボ | English Structure Lab",
  "shortName": "英文構造ラボ",
  "version": "0.1.0",
  "startUrl": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "themeColor": "#244f77",
  "backgroundColor": "#f3f5f7",
  "serviceWorker": {
    "enabled": true,
    "path": "./sw.js",
    "cacheVersion": "v1",
    "offlinePolicy": "cache-first-static"
  },
  "storage": {
    "policy": "local-only",
    "technology": "localStorage"
  },
  "deployment": {
    "target": "github-pages",
    "basePathPolicy": "relative"
  },
  "icons": [
    "./app-icon-180.png",
    "./app-icon-512.png"
  ]
}
